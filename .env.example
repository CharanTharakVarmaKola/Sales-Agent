# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.
# Mirrors orchestrator/posture.py CHANNELS + orchestrator/live.py call-time
# reads. Placeholder values only. llm/ollama is keyless by design
# (OLLAMA_BASE_URL presence is the credential — no secret exists).

# Kill-switch (STANDING LAW): uncached read, OUTREACH_LIVE=1 enables.
OUTREACH_LIVE=0

# llm/omniroute (OMNIROUTE_BASE_URL optional, MODEL + KEY required)
OMNIROUTE_API_KEY=CHANGEME
OMNIROUTE_MODEL=CHANGEME
OMNIROUTE_BASE_URL=https://api.cheaperinference.com/v1

# llm/freellmapi
FREELLMAPI_API_KEY=CHANGEME

# llm/ollama (keyless local — no secret, base URL + model only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=CHANGEME

# Consumer lease window (seconds, default 600)
OUTREACH_LEASE_SECONDS=600

# email/gmail OAuth path (live-session credentials)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# email/zoho OAuth path (slots 01-04 live; _05 deprecated, never read)
ZOHO_CLIENT_ID_01=your_zoho_client_id_01
ZOHO_CLIENT_SECRET_01=your_zoho_client_secret_01
ZOHO_REFRESH_TOKEN_01=your_zoho_refresh_token_01
ZOHO_ACCOUNT_EMAIL_01=your_zoho_account_email_01

ZOHO_CLIENT_ID_02=your_zoho_client_id_02
ZOHO_CLIENT_SECRET_02=your_zoho_client_secret_02
ZOHO_REFRESH_TOKEN_02=your_zoho_refresh_token_02
ZOHO_ACCOUNT_EMAIL_02=your_zoho_account_email_02

ZOHO_CLIENT_ID_03=your_zoho_client_id_03
ZOHO_CLIENT_SECRET_03=your_zoho_client_secret_03
ZOHO_REFRESH_TOKEN_03=your_zoho_refresh_token_03
ZOHO_ACCOUNT_EMAIL_03=your_zoho_account_email_03

ZOHO_CLIENT_ID_04=your_zoho_client_id_04
ZOHO_CLIENT_SECRET_04=your_zoho_client_secret_04
ZOHO_REFRESH_TOKEN_04=your_zoho_refresh_token_04
ZOHO_ACCOUNT_EMAIL_04=your_zoho_account_email_04

# email/gmail-smtp transport set
GMAIL_SMTP_HOST=CHANGEME
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=CHANGEME
GMAIL_SMTP_PASS=CHANGEME

# email/zoho-smtp transport sets (slots 01-04 live)
ZOHO_SMTP_01_HOST=CHANGEME
ZOHO_SMTP_01_PORT=465
ZOHO_SMTP_01_USER=CHANGEME
ZOHO_SMTP_01_PASS=CHANGEME
ZOHO_SMTP_02_HOST=CHANGEME
ZOHO_SMTP_02_PORT=465
ZOHO_SMTP_02_USER=CHANGEME
ZOHO_SMTP_02_PASS=CHANGEME
ZOHO_SMTP_03_HOST=CHANGEME
ZOHO_SMTP_03_PORT=465
ZOHO_SMTP_03_USER=CHANGEME
ZOHO_SMTP_03_PASS=CHANGEME
ZOHO_SMTP_04_HOST=CHANGEME
ZOHO_SMTP_04_PORT=465
ZOHO_SMTP_04_USER=CHANGEME
ZOHO_SMTP_04_PASS=CHANGEME

# email/agentmail + email/agentmail-api
# (AGENTMAIL_SEND_PATH default /messages is UNVERIFIED_PENDING_LIVE_DOCS —
# verify against live docs before any real send.)
AGENTMAIL_API_KEY_A=your_agentmail_api_key_a
AGENTMAIL_API_BASE_URL=CHANGEME
AGENTMAIL_SEND_PATH=/messages
AGENTMAIL_TOS_MULTI_ACCOUNT_CONFIRMED=false

# Dashboard operator token (optional): when set, POST /api/kill-switch
# requires it (X-Operator-Token or Authorization: Bearer). Empty = localhost
# bind is the guard.
OPERATOR_TOKEN=
